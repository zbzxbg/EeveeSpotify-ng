ngzhwm_netease_romaji_local_description = "Takes effect only when \"Romanize Japanese Lyrics\" is enabled in the whoeevee menu. When enabled, NetEase's Japanese romaji is processed by local Japanese romanization instead of NetEase.";
ngzhwm_netease_hide_translation = "Hide NetEase Translation Button";
ngzhwm_netease_hide_translation_description = "When enabled, the NetEase lyrics source will not display the simplified Chinese translation of the lyrics.";
ngzhwm_romanization_description = "Configure romanization separately for each language. If romanization is not enabled for a language, its lyrics are displayed as-is without romanization.";
