ngzhwm_title = "ngzhwm Features";
ngzhwm_disable_lyrics_feature = "Disable Lyrics Function";
ngzhwm_disable_lyrics_feature_description = "As the name suggests, this disables all lyrics-related functions. When enabled, EeveeSpotify also prevents Spotify from returning its own lyrics.";
ngzhwm_multi_level_fallback = "Multi-level Lyrics Fallback";
ngzhwm_multi_level_fallback_description = "When enabled, lyrics are searched through multiple providers in this order: Musixmatch → PetitLyrics → LRCLIB → Genius. Musixmatch and PetitLyrics are given up to 5 seconds each, while LRCLIB and Genius are given up to 3 seconds each; if a provider doesn't return valid lyrics within its time limit, the next provider is queried. When disabled, lyrics are queried according to the user's settings in the whoeevee menu.";
