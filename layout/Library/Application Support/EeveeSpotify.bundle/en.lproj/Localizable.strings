// Patching

do_not_patch_premium = "Do Not Patch Premium";
patching_description = "EeveeSpotify intercepts requests to load user data, deserializes it, and modifies the parameters in real-time.

If you have an active Premium subscription, you can turn on Do Not Patch Premium. The tweak won't patch the data or restrict the use of Premium server-sided features.

A restart is required after changing.";

overwrite_configuration = "Overwrite Configuration";
overwrite_configuration_description = "Replace the remote configuration with the dumped Premium one. It isn't guaranteed to work, but it can solve problems such as ads appearing.";

// Lyrics

do_not_replace_lyrics = "Disable EeveeSpotify's Lyrics Replacement";
do_not_replace_lyrics_description = "When enabled, EeveeSpotify's lyrics functions are disabled, but Spotify is not prevented from returning its own lyrics.";
lyrics_source = "Lyrics Source";
lyrics_source_description = "You can select the lyrics source you prefer.

Genius: Offers the best quality lyrics, provides the most songs, and updates lyrics the fastest. Does not and will never be time-synced.

LRCLIB: The most open service, offering time-synced lyrics. However, it lacks lyrics for many songs.

Musixmatch: The service Spotify uses. Provides time-synced lyrics for many songs, but you'll need a user token to use this source.";
lyrics_additional_info = "If the tweak is unable to find a song or process the lyrics, you'll see a \"Couldn't load the lyrics for this song\" message. When using Genius or NetEase, some songs may have incorrect lyrics or display errors because their search method differs from other lyrics providers.";
petitlyrics_description = "PetitLyrics: Offers plenty of Japanese lyrics.";
spicylyrics_description = "SpicyLyrics: A lyrics provider serving the desktop Spotify client. It features word-by-word highlighted lyrics (currently unavailable on mobile) and lyrics for some songs that other providers do not have. Visit spicylyrics.org for more details.";
netease_description = "NetEase: A lyrics provider mainly serving mainland China. Lyrics for some songs may be updated faster than Genius, and most lyrics come with timestamps. However, support for users outside mainland China is weaker, and lyrics may be incorrect or timestamps may be misaligned.";

